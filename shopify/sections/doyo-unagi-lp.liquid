    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "ヒーロー：うなぎ原寸大（縦長）"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "商品：蒲焼 重箱盛り（4:5）"
    },
    {
      "type": "image_picker",
      "id": "step1_image",
      "label": "手順1 写真"
    },
    {
      "type": "image_picker",
      "id": "step2_image",
      "label": "手順2 写真"
    },
    {
      "type": "image_picker",
      "id": "step3_image",
      "label": "手順3 写真"
    },
    {
      "type": "image_picker",
      "id": "step4_image",
      "label": "手順4 写真"
    },
    {
      "type": "image_picker",
      "id": "bbq_image",
      "label": "BBQ：海鮮セット 盛り合わせ（1:1）"
    },
    {
      "type": "header",
      "content": "価格・リンク"
    },
    {
      "type": "text",
      "id": "unagi_price",
