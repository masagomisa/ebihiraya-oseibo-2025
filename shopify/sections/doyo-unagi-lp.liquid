      "default": "6,980"
    },
    {
      "type": "url",
      "id": "unagi_url",
      "label": "うなぎ予約リンク（商品ページURL）"
    },
    {
      "type": "url",
      "id": "line_url",
      "label": "LINE友だち追加URL"
    }
  ],
  "presets": [
    {
      "name": "土用の丑の日2026 LP"
    }
  ]
}
{% endschema %}
