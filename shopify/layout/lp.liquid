<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ page_title }} ｜ {{ shop.name }}</title>
<meta name="description" content="{{ page_description | escape }}">
<link rel="canonical" href="{{ canonical_url }}">
{{ content_for_header }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;600;900&family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho:wght@700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --urushi:#15100B;
    --urushi-2:#1F1812;
    --kin:#C9A24B;
    --kin-bright:#E4C272;
    --hi:#B43A2A;
    --washi:#F2EBDD;
    --washi-dim:#CFC4AE;
    --line:rgba(201,162,75,.28);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    background:var(--urushi);
    color:var(--washi);
    font-family:"Noto Sans JP",sans-serif;
    line-height:1.85;
    font-feature-settings:"palt";
    overflow-x:hidden;
  }
  .mincho{font-family:"Shippori Mincho","Noto Serif JP",serif;}
  .wrap{max-width:1040px;margin:0 auto;padding:0 24px;}

  .topbar{
    background:var(--hi);color:var(--washi);
    text-align:center;font-size:13px;letter-spacing:.08em;
    padding:9px 16px;font-weight:500;
  }
  .topbar strong{color:#fff;font-weight:700;}

  header.site{
    display:flex;align-items:center;justify-content:space-between;
    padding:18px 24px;border-bottom:1px solid var(--line);
    position:sticky;top:0;z-index:50;
    background:rgba(21,16,11,.86);backdrop-filter:blur(8px);
  }
  .brand{font-family:"Shippori Mincho",serif;font-weight:800;font-size:19px;letter-spacing:.14em;color:var(--washi);}
  .brand small{display:block;font-family:"Noto Sans JP";font-weight:400;font-size:10px;letter-spacing:.3em;color:var(--kin);margin-top:2px;}
  .nav-cta{
    font-size:13px;font-weight:700;letter-spacing:.06em;
    background:var(--kin);color:var(--urushi);
    padding:10px 20px;border-radius:2px;text-decoration:none;white-space:nowrap;
    transition:background .2s;
  }
  .nav-cta:hover{background:var(--kin-bright);}

  .hero{
    position:relative;padding:64px 0 72px;
    background:
      radial-gradient(120% 80% at 78% 30%, rgba(122,59,27,.45) 0%, transparent 55%),
      linear-gradient(180deg,#15100B 0%,#0F0B07 100%);
    overflow:hidden;
  }
  .hero::before{
    content:"";position:absolute;inset:0;opacity:.10;pointer-events:none;
    background-image:radial-gradient(circle at 100% 0, transparent 38px, var(--kin) 39px, transparent 40px),
                     radial-gradient(circle at 100% 0, transparent 64px, var(--kin) 65px, transparent 66px),
                     radial-gradient(circle at 100% 0, transparent 90px, var(--kin) 91px, transparent 92px);
    background-size:120px 120px;background-position:top right;
  }
  .hero-grid{position:relative;display:grid;grid-template-columns:1.15fr .85fr;gap:32px;align-items:center;}
  .eyebrow{
    display:inline-flex;align-items:center;gap:10px;
    font-size:13px;letter-spacing:.22em;color:var(--kin);font-weight:500;margin-bottom:22px;
  }
  .eyebrow::before{content:"";width:34px;height:1px;background:var(--kin);}
  .hero h1{
    font-family:"Shippori Mincho",serif;font-weight:800;
    font-size:clamp(46px,8vw,88px);line-height:1.02;letter-spacing:.04em;
    color:var(--washi);margin-bottom:8px;
  }
  .hero h1 .ushi{color:var(--kin-bright);display:block;font-size:1.32em;text-shadow:0 2px 30px rgba(228,194,114,.25);}
  .hero .date{
    font-family:"Shippori Mincho",serif;font-size:clamp(20px,3vw,26px);
    color:var(--washi);margin:18px 0 6px;letter-spacing:.05em;
  }
  .hero .date b{color:var(--hi);font-size:1.15em;}
  .hero .note-2nd{
    font-size:14px;color:var(--washi-dim);letter-spacing:.04em;margin-bottom:28px;
    border-left:2px solid var(--hi);padding-left:12px;
  }
  .hero .note-2nd b{color:var(--kin-bright);font-weight:700;}
  .hero-cta{display:flex;gap:14px;flex-wrap:wrap;}
  .btn-primary{
    background:var(--kin);color:var(--urushi);font-weight:700;letter-spacing:.06em;
    padding:16px 32px;border-radius:2px;text-decoration:none;font-size:15px;
    transition:transform .15s,background .2s;
  }
  .btn-primary:hover{background:var(--kin-bright);transform:translateY(-2px);}
  .btn-ghost{
    border:1px solid var(--line);color:var(--washi);font-weight:500;letter-spacing:.06em;
    padding:16px 28px;border-radius:2px;text-decoration:none;font-size:15px;transition:border-color .2s;
  }
  .btn-ghost:hover{border-color:var(--kin);}

  .unagi-stage{position:relative;display:flex;justify-content:center;align-items:stretch;min-height:460px;}
  .scale-arrow{
    position:absolute;left:-6px;top:0;bottom:0;width:30px;
    display:flex;flex-direction:column;align-items:center;justify-content:space-between;
    color:var(--kin);font-size:11px;letter-spacing:.3em;writing-mode:vertical-rl;
  }
  .scale-arrow .bar{width:1px;flex:1;background:linear-gradient(var(--kin),transparent 8%,transparent 92%,var(--kin));margin:6px 0;}
  .scale-arrow .tip{font-family:"Shippori Mincho";writing-mode:horizontal-tb;background:var(--hi);color:#fff;padding:4px 7px;border-radius:2px;font-size:10px;letter-spacing:.1em;}
  .unagi-hero-img{
    width:148px;border-radius:80px 80px 80px 80px / 180px 180px 180px 180px;
    overflow:hidden;border:1px solid rgba(201,162,75,.25);
    box-shadow:0 0 50px rgba(122,59,27,.4);
  }
  .unagi-hero-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .unagi-hero-img--placeholder{
    background:linear-gradient(105deg, #3a1d0d 0%, #6b3415 22%, #8f4a1e 40%, #5e2e12 60%, #2a1408 100%);
    box-shadow:inset 0 0 60px rgba(0,0,0,.6), 0 0 50px rgba(122,59,27,.4);
    position:relative;
  }
  .unagi-hero-img--placeholder::after{
    content:"";position:absolute;top:0;bottom:0;left:30%;width:22%;
    background:linear-gradient(90deg,transparent,rgba(228,194,114,.55),transparent);
    filter:blur(3px);animation:sheen 6s ease-in-out infinite;
  }
  @keyframes sheen{0%,100%{transform:translateX(-8px);opacity:.5}50%{transform:translateX(8px);opacity:.85}}

  .delivery-bar{background:var(--urushi-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line);}
  .delivery-grid{display:grid;grid-template-columns:repeat(3,1fr);}
  .dcol{padding:30px 26px;text-align:center;border-right:1px solid var(--line);}
  .dcol:last-child{border-right:none;}
  .dcol .k{font-size:11px;letter-spacing:.2em;color:var(--kin);margin-bottom:8px;}
  .dcol .t{font-family:"Shippori Mincho";font-size:19px;font-weight:700;margin-bottom:6px;}
  .dcol .d{font-size:13px;color:var(--washi-dim);line-height:1.7;}
  .dcol .deadline{color:var(--hi);font-weight:700;}

  section{padding:78px 0;}
  .sec-eyebrow{font-size:12px;letter-spacing:.26em;color:var(--kin);margin-bottom:14px;}
  .sec-title{font-family:"Shippori Mincho";font-weight:800;font-size:clamp(28px,4.5vw,40px);letter-spacing:.04em;line-height:1.3;margin-bottom:18px;}
  .sec-lead{color:var(--washi-dim);max-width:620px;font-size:15px;}

  .product{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;}
  .product-visual{aspect-ratio:4/5;border-radius:4px;overflow:hidden;border:1px solid var(--line);}
  .product-visual img{width:100%;height:100%;object-fit:cover;display:block;}
  .product-visual--placeholder{
    background:linear-gradient(150deg,#241409,#3a1d0d 50%,#1a0f07);
    display:flex;align-items:center;justify-content:center;text-align:center;
    color:var(--washi-dim);font-size:12px;letter-spacing:.1em;padding:24px;line-height:1.9;
  }
  .price-row{display:flex;align-items:baseline;gap:6px;margin:20px 0 4px;}
  .price-row .yen{font-size:20px;color:var(--washi);}
  .price-row .num{font-family:"Shippori Mincho";font-weight:800;font-size:64px;color:var(--kin-bright);line-height:1;}
  .price-row .tax{font-size:13px;color:var(--washi-dim);}
  .price-cap{font-size:12px;color:var(--washi-dim);margin-bottom:22px;}
  .feat-list{list-style:none;margin:22px 0;}
  .feat-list li{padding:11px 0 11px 26px;border-bottom:1px solid var(--line);font-size:14.5px;position:relative;}
  .feat-list li::before{content:"鰻";font-family:"Shippori Mincho";color:var(--kin);font-size:12px;position:absolute;left:0;top:13px;}

  .steps{background:var(--urushi-2);}
  .step-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:40px;}
  .step{background:var(--urushi);border:1px solid var(--line);border-radius:4px;padding:24px 20px;}
  .step .no{font-family:"Shippori Mincho";font-size:13px;color:var(--kin);letter-spacing:.1em;margin-bottom:14px;}
  .step .no b{font-size:30px;color:var(--kin-bright);}
  .step .step-ph{aspect-ratio:1;border-radius:3px;overflow:hidden;margin-bottom:14px;}
  .step .step-ph img{width:100%;height:100%;object-fit:cover;display:block;}
  .step .step-ph--placeholder{background:linear-gradient(135deg,#2a1810,#3a1d0d);display:flex;align-items:center;justify-content:center;font-size:10px;color:var(--washi-dim);letter-spacing:.08em;}
  .step p{font-size:13.5px;color:var(--washi);line-height:1.7;}

  .bbq{
    background:
      radial-gradient(110% 70% at 20% 20%, rgba(180,58,42,.30), transparent 55%),
      linear-gradient(180deg,#1a0d09,#150d0a);
    border-top:1px solid var(--line);
  }
  .bbq .sec-eyebrow{color:var(--hi);}
  .bbq-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:48px;align-items:center;margin-top:8px;}
  .bbq-visual{aspect-ratio:1;border-radius:4px;overflow:hidden;border:1px solid rgba(180,58,42,.4);}
  .bbq-visual img{width:100%;height:100%;object-fit:cover;display:block;}
  .bbq-visual--placeholder{background:linear-gradient(150deg,#3a1410,#5a2018 55%,#1a0d09);display:flex;align-items:center;justify-content:center;color:var(--washi-dim);font-size:12px;letter-spacing:.1em;text-align:center;padding:24px;line-height:1.9;}
  .bbq-sets{display:flex;flex-direction:column;gap:16px;margin-top:24px;}
  .set-card{
    border:1px solid var(--line);border-radius:4px;padding:22px 24px;
    display:flex;justify-content:space-between;align-items:center;gap:16px;
    background:rgba(21,13,9,.5);transition:border-color .2s,transform .15s;
  }
  .set-card:hover{border-color:var(--hi);transform:translateX(4px);}
  .set-card .sname{font-family:"Shippori Mincho";font-weight:700;font-size:18px;margin-bottom:4px;}
  .set-card .sdesc{font-size:12.5px;color:var(--washi-dim);}
  .set-card .sprice{font-family:"Shippori Mincho";font-weight:800;font-size:28px;color:var(--kin-bright);white-space:nowrap;}
  .set-card .sprice small{font-size:12px;color:var(--washi-dim);font-weight:400;}

  .final{background:linear-gradient(180deg,#0F0B07,#15100B);text-align:center;}
  .final h2{font-family:"Shippori Mincho";font-weight:800;font-size:clamp(26px,4vw,38px);letter-spacing:.05em;margin-bottom:16px;}
  .final p{color:var(--washi-dim);max-width:520px;margin:0 auto 32px;font-size:15px;}
  .final-cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;}
  .btn-line{background:#06C755;color:#fff;font-weight:700;padding:16px 30px;border-radius:2px;text-decoration:none;font-size:15px;letter-spacing:.04em;transition:opacity .2s;}
  .btn-line:hover{opacity:.88;}

  footer.lp-foot{background:var(--urushi-2);border-top:1px solid var(--line);padding:48px 0 40px;}
  .foot-grid{display:flex;justify-content:space-between;flex-wrap:wrap;gap:30px;}
  .foot-brand{font-family:"Shippori Mincho";font-weight:800;font-size:20px;letter-spacing:.12em;}
  .foot-brand small{display:block;font-family:"Noto Sans JP";font-weight:400;font-size:10px;letter-spacing:.28em;color:var(--kin);margin-top:4px;}
  .foot-info{font-size:13px;color:var(--washi-dim);line-height:2;text-align:right;}
  .foot-info .closed{color:var(--hi);}

  @media(max-width:820px){
    .hero-grid{grid-template-columns:1fr;gap:24px;}
    .unagi-stage{min-height:380px;order:-1;}
    .delivery-grid{grid-template-columns:1fr;}
    .dcol{border-right:none;border-bottom:1px solid var(--line);}
    .dcol:last-child{border-bottom:none;}
    .product{grid-template-columns:1fr;gap:28px;}
    .step-grid{grid-template-columns:1fr 1fr;}
    .bbq-grid{grid-template-columns:1fr;gap:28px;}
    .foot-info{text-align:left;}
  }
  @media(max-width:440px){
    .step-grid{grid-template-columns:1fr;}
    .set-card{flex-direction:column;align-items:flex-start;}
  }
  @media(prefers-reduced-motion:reduce){
    .unagi-hero-img--placeholder::after{animation:none;}
    *{scroll-behavior:auto;}
  }
  .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease;}
  .reveal.in{opacity:1;transform:none;}
  :focus-visible{outline:2px solid var(--kin-bright);outline-offset:3px;}
</style>
</head>
<body>
{{ content_for_layout }}
</body>
</html>
